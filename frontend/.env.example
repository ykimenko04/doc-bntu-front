# Пример настроек для разработки.
#
# В обычном dev-режиме фронт работает на http://localhost:5173,
# а запросы к бэкенду идут ПРОКСИРОВАННО на порт 8000 (это снимает CORS).

# Куда проксировать запросы (/api, /login, /logout, ...)
VITE_PROXY_TARGET=http://localhost:8000

# Порт Vite dev-сервера (если нужно поменять)
VITE_DEV_PORT=5173

# Если бэкенд настроен на CORS (Access-Control-Allow-Origin + Credentials),
# можно включить прямые запросы в обход прокси:
# VITE_API_URL=http://localhost:8000
